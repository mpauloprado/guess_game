# Copie para .env e ajuste se quiser (todas têm valor padrão no docker-compose.yml)

# Versões das imagens — trocar aqui e rodar "docker compose up -d" atualiza o componente
BACKEND_VERSION=1.0.0
FRONTEND_VERSION=1.0.0
POSTGRES_VERSION=16.6-alpine
# Prefixo de registry opcional, ex.: ghcr.io/usuario/  (com a barra no fim)
REGISTRY=

# Quantidade de instâncias do backend atrás do NGINX
BACKEND_REPLICAS=3

# Porta do host para acessar o jogo
HTTP_PORT=80

# Banco (credenciais de laboratório)
DB_USER=guess
DB_PASSWORD=guess-lab-pass
DB_NAME=guess
